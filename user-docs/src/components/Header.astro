---
// Starlight's public Search component. Both sites use Pagefind and don't override Search,
// so it always renders (Starlight 0.42 no longer types the virtual:starlight/* modules).
import Search from '@astrojs/starlight/components/Search.astro';
import SharedHeader from '../shared-ui/components/SiteHeader.astro';
---

<SharedHeader>
	<div slot="extra" class="jr-docs-search">
		<Search />
	</div>
</SharedHeader>

<style>
	.jr-docs-search {
		display: flex;
		align-items: center;
	}
	.jr-docs-search :global(button[data-open-modal]) {
		padding: 0.4rem 0.75rem;
		font-size: 0.875rem;
	}
</style>
