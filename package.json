{
	"name": "jellyrock-docs",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Charles Ewert",
	"type": "module",
	"workspaces": [
		"user-docs",
		"dev-docs"
	],
	"scripts": {
		"dev:user": "npm run dev --workspace user-docs",
		"dev:dev": "npm run dev --workspace dev-docs",
		"build:user": "npm run build --workspace user-docs",
		"build:dev": "npm run build --workspace dev-docs",
		"build": "npm run build:user && npm run build:dev",
		"build:strict": "bash scripts/build-warnings.sh -- npm run build",
		"check": "npm run check:astro && npm run check:tests && npm run check:eslint && npm run check:prettier",
		"check:astro:user": "npm --workspace user-docs exec -- astro sync && npm --workspace user-docs exec -- astro check",
		"check:astro:dev": "npm --workspace dev-docs exec -- astro sync && npm --workspace dev-docs exec -- astro check",
		"check:astro": "npm run check:astro:user && npm run check:astro:dev",
		"check:tests": "tsc -p tsconfig.json",
		"check:eslint": "eslint .",
		"check:prettier": "prettier --check .",
		"fix": "eslint --fix . && prettier --write .",
		"test": "scripts/playwright-docker.sh playwright test",
		"test:e2e": "playwright test --grep-invert @visual",
		"test:visual": "scripts/playwright-docker.sh playwright test --grep @visual",
		"test:visual:update": "scripts/playwright-docker.sh playwright test --grep @visual --update-snapshots"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@typescript-eslint/parser": "8.72.0",
		"eslint": "10.13.0",
		"eslint-plugin-astro": "3.2.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0"
	},
	"packageManager": "npm@12.2.1"
}
